# Default: use the locally installed and authenticated traex CLI.
NPC_AI_PROVIDER=traex
NPC_AI_TRAEX_COMMAND=traex
NPC_AI_MODEL=Doubao-Seed-2.1-Turbo
NPC_AI_TIMEOUT=120
NPC_HOST=127.0.0.1
NPC_PORT=8000

# Vite dev server proxy target (optional).
NPC_BACKEND_URL=http://127.0.0.1:8000

# For an OpenAI-compatible HTTP service, set NPC_AI_PROVIDER=openai.
# NPC_AI_MODEL must then be the model ID provided by that service.
NPC_AI_BASE_URL=https://api.openai.com/v1
NPC_AI_API_KEY=replace-with-your-api-key
